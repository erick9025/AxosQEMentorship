{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "tests/**/*.ts",
    "pom/**/*.ts",
    "api/**/*.ts",
    "utils/**/*.ts",
    "playwright.config.ts"
  ]
}