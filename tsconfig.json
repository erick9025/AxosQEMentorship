{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [
    "pom/**/*.ts",
    "tests/api/**/*.ts",
    "tests/fixtures/**/*.ts",
    "tests/ui/**/*.ts",
    "playwright.config.ts",
    "tests/homeworks/ElianaZelada/W4E5/Pages/InventoryPage.ts"
  ]
}
